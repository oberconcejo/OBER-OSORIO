datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. MULTI-TENANCY & SEGURIDAD (FASE 3)
// ==========================================
model Organization {
  id                 String                 @id @default(uuid())
  name               String
  users              User[]
  departments        Department[]
  electors           Elector[]
  team_members       TeamMember[]
  team_positions     TeamPosition[]
  plans              Plan[]
  tasks              Task[]
  notifications      Notification[]
  election_days      ElectionDayOperation[]
  elections          Election[]
  audit_logs         AuditLog[]
  export_jobs        ExportJob[]
  saved_reports      SavedReport[]
  AnomalyAlert       AnomalyAlert[]
  SimulationScenario SimulationScenario[]
  activities         Activity[]
  operations         Operation[]
  mobilization_activities MobilizationActivity[]
  incidents          Incident[]
  resources          OperationalResource[]
  operational_points OperationalPoint[]
  encuestas          Encuesta[]
  transacciones      TransaccionFinanciera[]
}

model User {
  id                    String               @id @default(uuid())
  organization_id       String
  organization          Organization         @relation(fields: [organization_id], references: [id])
  name                  String
  email                 String               @unique
  password_hash         String
  status                String               @default("ACTIVE")
  team_member           TeamMember?
  notifications         Notification[]
  audit_logs            AuditLog[]
  table_results         PollingTableResult[]
  acts                  ElectionAct[]
  export_jobs           ExportJob[]
  saved_reports         SavedReport[]
  dashboard_preferences DashboardPreference?
  AnomalyAlert          AnomalyAlert[]       @relation("AnomalyReviewer")
  SimulationScenario    SimulationScenario[]
  activity_comments     ActivityComment[]
}

// ==========================================
// 2. GESTIÃ“N TERRITORIAL (FASE 4)
// ==========================================
model Department {
  id              String         @id @default(uuid())
  organization_id String
  organization    Organization   @relation(fields: [organization_id], references: [id])
  name            String
  municipalities  Municipality[]

  @@unique([organization_id, name])
}

model Municipality {
  id               String                 @id @default(uuid())
  department_id    String
  department       Department             @relation(fields: [department_id], references: [id])
  name             String
  zones            Zone[]
  team_assignments TeamAssignment[]
  plans            Plan[]
  tasks            Task[]
  activities       Activity[]
  mobilization_activities MobilizationActivity[]
  mobilization_incidents Incident[]             @relation("MuniIncidents")
  resources          OperationalResource[]
  operational_points OperationalPoint[]
}

model Zone {
  id               String                 @id @default(uuid())
  municipality_id  String
  municipality     Municipality           @relation(fields: [municipality_id], references: [id])
  name             String
  polling_stations PollingStation[]
  team_assignments TeamAssignment[]
  plans            Plan[]
  tasks            Task[]
  activities       Activity[]
  mobilization_activities MobilizationActivity[]
  mobilization_incidents Incident[]             @relation("ZoneIncidents")
  resources          OperationalResource[]
  operational_points OperationalPoint[]
}

model PollingStation {
  id               String                @id @default(uuid())
  zone_id          String
  zone             Zone                  @relation(fields: [zone_id], references: [id])
  name             String
  polling_tables   PollingTable[]
  team_assignments TeamAssignment[]
  plans            Plan[]
  tasks            Task[]
  field_reports    FieldReport[]
  incidents        OperationalIncident[]
  checkins         CheckIn[]
  activities       Activity[]
  mobilization_activities MobilizationActivity[]
  mobilization_incidents Incident[]            @relation("StationIncidents")
  resources          OperationalResource[]
  operational_points OperationalPoint[]
}

model PollingTable {
  id                 String                @id @default(uuid())
  polling_station_id String
  polling_station    PollingStation        @relation(fields: [polling_station_id], references: [id])
  table_number       String
  team_assignments   TeamAssignment[]
  tasks              Task[]
  field_reports      FieldReport[]
  incidents          OperationalIncident[]
  results            PollingTableResult[]
  acts               ElectionAct[]
  activities         Activity[]
  mobilization_activities MobilizationActivity[]
  mobilization_incidents Incident[]            @relation("TableIncidents")
  resources          OperationalResource[]
  operational_points OperationalPoint[]
}

// ==========================================
// 3. GESTIÃ“N DE ELECTORES (FASE 5)
// ==========================================
model Elector {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  document_type   String
  document_number String
  first_name      String
  last_name       String
  status          String       @default("ACTIVE")
  created_at      DateTime     @default(now())

  @@unique([organization_id, document_type, document_number])
}

// ==========================================
// 4. EQUIPO ELECTORAL (FASE 6)
// ==========================================
model TeamMember {
  id              String           @id @default(uuid())
  organization_id String
  organization    Organization     @relation(fields: [organization_id], references: [id])
  user_id         String?          @unique
  user            User?            @relation(fields: [user_id], references: [id])
  document_type   String
  document_number String
  first_name      String
  last_name       String
  phone           String?
  status          String           @default("ACTIVE")
  assignments         TeamAssignment[]
  tasks               Task[]
  field_reports       FieldReport[]
  objectives          Objective[]
  assigned_activities ActivityAssignee[]
  mobilization_activities MobilizationActivity[]
  reported_incidents  Incident[]           @relation("IncidentReporter")
  assigned_incidents  IncidentAssignment[]
  assigned_resources  ResourceAssignment[]
  operational_points  OperationalPoint[]
  checkins        CheckIn[]
  created_at      DateTime         @default(now())

  @@unique([organization_id, document_type, document_number])
}

model TeamPosition {
  id              String           @id @default(uuid())
  organization_id String
  organization    Organization     @relation(fields: [organization_id], references: [id])
  name            String
  assignments     TeamAssignment[]
}

model TeamAssignment {
  id          String       @id @default(uuid())
  member_id   String
  member      TeamMember   @relation(fields: [member_id], references: [id])
  position_id String
  position    TeamPosition @relation(fields: [position_id], references: [id])

  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])

  start_date DateTime
  end_date   DateTime?
  status     String    @default("ACTIVE")
  created_at DateTime  @default(now())
}

// ==========================================
// 5. PLANIFICACIÃ“N Y GESTIÃ“N OPERATIVA (FASE 7)
// ==========================================
model Plan {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  start_date      DateTime
  end_date        DateTime?
  status          String       @default("DRAFT")
  priority        String       @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA

  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])

  tasks      Task[]
  objectives Objective[]
  activities Activity[]
  created_at DateTime @default(now())
}

model Task {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  plan_id         String?
  plan            Plan?        @relation(fields: [plan_id], references: [id])
  title           String
  description     String?
  priority        String       @default("MEDIUM")
  status          String       @default("PENDING")
  due_date        DateTime?

  assignee_id String?
  assignee    TeamMember? @relation(fields: [assignee_id], references: [id])

  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])

  created_at DateTime @default(now())
}

model Objective {
  id              String       @id @default(uuid())
  plan_id         String
  plan            Plan         @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          String       @default("PENDING") // PENDIENTE, EN_PROGRESO, COMPLETADO, CANCELADO
  priority        String       @default("MEDIUM")
  due_date        DateTime?
  assignee_id     String?
  assignee        TeamMember?  @relation(fields: [assignee_id], references: [id])
  
  activities      Activity[]
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}

model Activity {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  plan_id         String
  plan            Plan         @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  objective_id    String?
  objective       Objective?   @relation(fields: [objective_id], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  type            String       @default("OTRA") // Reunion, Visita territorial, Capacitacion, Organizacion, Seguimiento, Comunicacion, Logistica, Administrativa, Otra
  priority        String       @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  status          String       @default("PENDIENTE") // PENDIENTE, EN_PROGRESO, COMPLETADA, BLOQUEADA, CANCELADA
  
  start_date      DateTime
  due_date        DateTime
  completed_at    DateTime?
  
  // Territorial association
  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])
  
  // Assignees M:N
  assignees       ActivityAssignee[]
  
  // Dependencies
  dependencies    ActivityDependency[] @relation("ActivityDependsOn")
  dependents      ActivityDependency[] @relation("ActivityIsDependencyOf")
  
  // Checklist
  checklist       ActivityChecklist[]
  
  // Comments
  comments        ActivityComment[]
  
  // Evidence
  evidence        ActivityEvidence[]
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}

model ActivityAssignee {
  id              String       @id @default(uuid())
  activity_id     String
  activity        Activity     @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  member_id       String
  member          TeamMember   @relation(fields: [member_id], references: [id])
  
  @@unique([activity_id, member_id])
}

model ActivityDependency {
  id              String       @id @default(uuid())
  activity_id     String
  activity        Activity     @relation("ActivityIsDependencyOf", fields: [activity_id], references: [id], onDelete: Cascade)
  depends_on_id   String
  depends_on      Activity     @relation("ActivityDependsOn", fields: [depends_on_id], references: [id], onDelete: Cascade)
  
  @@unique([activity_id, depends_on_id])
}

model ActivityChecklist {
  id              String       @id @default(uuid())
  activity_id     String
  activity        Activity     @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  title           String
  is_completed    Boolean      @default(false)
  created_at      DateTime     @default(now())
}

model ActivityComment {
  id              String       @id @default(uuid())
  activity_id     String
  activity        Activity     @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  content         String
  created_at      DateTime     @default(now())
}

model ActivityEvidence {
  id              String       @id @default(uuid())
  activity_id     String
  activity        Activity     @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  file_name       String
  file_url        String
  uploaded_at     DateTime     @default(now())
}

model Notification {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  message         String
  type            String       @default("INFO")
  is_read         Boolean      @default(false)
  created_at      DateTime     @default(now())
}

// ==========================================
// 6. DÃA ELECTORAL Y OPERACIÃ“N (FASE 8)
// ==========================================
model ElectionDayOperation {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  start_datetime  DateTime
  end_datetime    DateTime?
  status          String       @default("PLANNED")

  reports   FieldReport[]
  incidents OperationalIncident[]
  checkins  CheckIn[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model FieldReport {
  id              String               @id @default(uuid())
  organization_id String
  election_day_id String
  election_day    ElectionDayOperation @relation(fields: [election_day_id], references: [id])

  client_uuid String  @unique
  report_type String
  status      String
  description String?

  reporter_id String
  reporter    TeamMember @relation(fields: [reporter_id], references: [id])

  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])

  reported_at DateTime @default(now())
  created_at  DateTime @default(now())
}

model OperationalIncident {
  id              String               @id @default(uuid())
  organization_id String
  election_day_id String
  election_day    ElectionDayOperation @relation(fields: [election_day_id], references: [id])

  client_uuid String @unique
  type        String
  priority    String @default("MEDIUM")
  status      String @default("OPEN")
  description String

  reporter_id String
  assignee_id String?

  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])

  resolved_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

model CheckIn {
  id              String               @id @default(uuid())
  organization_id String
  election_day_id String
  election_day    ElectionDayOperation @relation(fields: [election_day_id], references: [id])

  client_uuid String     @unique
  type        String
  member_id   String
  member      TeamMember @relation(fields: [member_id], references: [id])

  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  status             String          @default("REPORTED")

  reported_at DateTime @default(now())
}

// ==========================================
// 7. RESULTADOS ELECTORALES Y ESCRUTINIO (FASE 9)
// ==========================================
model Election {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  election_type   String
  election_date   DateTime
  status          String       @default("DRAFT")

  candidates    Candidate[]
  acts          ElectionAct[]
  table_results PollingTableResult[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Candidate {
  id             String   @id @default(uuid())
  election_id    String
  election       Election @relation(fields: [election_id], references: [id])
  name           String
  ballot_number  String?
  party_or_group String?
  position       String?
  status         String   @default("ACTIVE")

  results CandidateResult[]
}

model ElectionAct {
  id               String       @id @default(uuid())
  election_id      String
  election         Election     @relation(fields: [election_id], references: [id])
  polling_table_id String
  polling_table    PollingTable @relation(fields: [polling_table_id], references: [id])

  document_reference String
  checksum           String @unique
  version            Int    @default(1)
  status             String @default("UPLOADED")

  uploaded_by String
  uploader    User   @relation(fields: [uploaded_by], references: [id])

  results PollingTableResult[]

  uploaded_at DateTime @default(now())
}

model PollingTableResult {
  id               String       @id @default(uuid())
  election_id      String
  election         Election     @relation(fields: [election_id], references: [id])
  polling_table_id String
  polling_table    PollingTable @relation(fields: [polling_table_id], references: [id])
  act_id           String?
  act              ElectionAct? @relation(fields: [act_id], references: [id])

  version Int    @default(1)
  status  String @default("REPORTED")

  total_votes       Int     @default(0)
  correction_reason String?

  reported_by String
  reporter    User   @relation(fields: [reported_by], references: [id])

  candidate_results CandidateResult[]
  category_results  CategoryResult[]

  reported_at DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model CandidateResult {
  id           String             @id @default(uuid())
  result_id    String
  result       PollingTableResult @relation(fields: [result_id], references: [id])
  candidate_id String
  candidate    Candidate          @relation(fields: [candidate_id], references: [id])
  votes        Int                @default(0)
}

model CategoryResult {
  id        String             @id @default(uuid())
  result_id String
  result    PollingTableResult @relation(fields: [result_id], references: [id])
  category  String
  votes     Int                @default(0)
}

// ==========================================
// 8. CENTRO DE CONTROL, ANALÃTICA Y EXPORTACIONES (FASE 10)
// ==========================================
model ExportJob {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])

  type          String // EJ: TERRITORIAL_REPORT, AUDIT_LOG, ELECTION_RESULTS
  filters       String? // Filtros aplicados
  status        String  @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, EXPIRED
  file_url      String? // URL temporal y segura
  error_message String?

  expires_at   DateTime?
  created_at   DateTime  @default(now())
  completed_at DateTime?
}

model SavedReport {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])

  name        String
  type        String
  config_json String // Columnas, filtros y ordenamientos favoritos

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model DashboardPreference {
  id      String @id @default(uuid())
  user_id String @unique
  user    User   @relation(fields: [user_id], references: [id])

  widgets_json String // PosiciÃ³n y visibilidad de los widgets (Regla 37, 39)

  updated_at DateTime @updatedAt
}

// Tabla de AuditorÃ­a unificada transversal (Regla 18, 19, 21)
model AuditLog {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])
  action          String
  entity_name     String
  entity_id       String
  new_values      String?
  created_at      DateTime     @default(now())

  @@index([organization_id, created_at]) // Rendimiento para analÃ­tica de auditorÃ­a
}

// ==========================================
// 9. INTELIGENCIA ELECTORAL Y ANALÍTICA AVANZADA (FASE 16)
// ==========================================
model AnomalyAlert {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])

  type     String // EJ: "VOTE_SPIKE", "LATENCY_DROP"
  severity String // EJ: "LOW", "MEDIUM", "HIGH", "CRITICAL"
  score    Float // 0 a 100

  description  String
  context_json String? // Motivo de la IA

  status          String  @default("DETECTED") // DETECTED, IN_REVIEW, CONFIRMED, DISMISSED
  reviewed_by     String?
  reviewer        User?   @relation("AnomalyReviewer", fields: [reviewed_by], references: [id])
  resolution_note String?

  detected_at DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([organization_id, status])
}

model IntelligenceModel {
  id           String  @id @default(uuid())
  name         String
  version      String
  type         String // "ANOMALY", "FORECAST", "SIMULATION"
  algorithm    String
  metrics_json String?

  status String @default("ACTIVE") // ACTIVE, RETIRED

  created_at DateTime @default(now())
}

model SimulationScenario {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  user_id         String
  user            User         @relation(fields: [user_id], references: [id])

  name            String
  parameters_json String // Variables X e Y de predicción
  result_json     String // Resultados simulados

  created_at DateTime @default(now())
}

// ==========================================
// 10. MOVILIZACIÓN ELECTORAL Y OPERACIÓN (FASE 15)
// ==========================================

model Operation {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  description     String?
  start_date      DateTime
  end_date        DateTime?
  status          String       @default("BORRADOR") // BORRADOR, PROGRAMADA, ACTIVA, PAUSADA, COMPLETADA, CANCELADA
  priority        String       @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  
  days            OperationDay[]
  activities      MobilizationActivity[]
  incidents       Incident[]
  
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
}

model OperationDay {
  id              String                 @id @default(uuid())
  operation_id    String
  operation       Operation              @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  name            String
  date            DateTime
  start_time      String
  end_time        String
  status          String                 @default("PROGRAMADA") // PROGRAMADA, ACTIVA, COMPLETADA
  description     String?
  
  activities      MobilizationActivity[]
}

model MobilizationActivity {
  id                 String       @id @default(uuid())
  organization_id    String
  organization       Organization @relation(fields: [organization_id], references: [id])
  operation_id       String
  operation          Operation    @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  operation_day_id   String?
  operation_day      OperationDay? @relation(fields: [operation_day_id], references: [id], onDelete: Cascade)
  
  name               String
  description        String?
  type               String       @default("OTRO") // Coordinacion, Reunion, Visita, Capacitacion, Logistica, Comunicacion, Apoyo operativo, Seguimiento, Otro
  priority           String       @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  status             String       @default("PENDIENTE") // PENDIENTE, EN_PROGRESO, COMPLETADA, BLOQUEADA, CANCELADA
  
  start_date_time    DateTime
  end_date_time      DateTime
  completed_at       DateTime?
  
  // Territorial links
  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])
  
  // Member link
  assigned_to_id     String?
  assigned_to        TeamMember?     @relation(fields: [assigned_to_id], references: [id])
  
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt
}

model OperationalPoint {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  type            String       @default("OTRO") // Coordinacion, Reunion, Logistica, Apoyo, Otro
  address         String?
  latitude        Float?
  longitude       Float?
  responsible_id  String?
  responsible     TeamMember?  @relation(fields: [responsible_id], references: [id])
  status          String       @default("ACTIVO") // ACTIVO, INACTIVO
  
  // Territorial Link
  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])
}

model Incident {
  id              String               @id @default(uuid())
  organization_id String
  organization    Organization         @relation(fields: [organization_id], references: [id])
  operation_id    String?
  operation       Operation?           @relation(fields: [operation_id], references: [id], onDelete: Cascade)
  title           String
  description     String
  type            String               @default("OTRA") // Retraso, Logistica, Comunicacion, Personal, Transporte, Ubicacion, Clima, Tecnica, Otra
  severity        String               @default("MEDIA") // BAJA, MEDIA, ALTA, CRITICA
  status          String               @default("ABIERTA") // ABIERTA, EN_REVISION, EN_PROCESO, RESUELTA, CERRADA
  
  reported_by_id  String
  reported_by     TeamMember           @relation("IncidentReporter", fields: [reported_by_id], references: [id])
  
  // Assignments M:N
  assignments     IncidentAssignment[]
  
  // History log
  history         IncidentHistory[]
  
  // Territorial link
  municipality_id    String?
  municipality       Municipality?   @relation("MuniIncidents", fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation("ZoneIncidents", fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation("StationIncidents", fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation("TableIncidents", fields: [polling_table_id], references: [id])
  
  created_at      DateTime             @default(now())
  resolved_at     DateTime?
}

model IncidentAssignment {
  id              String       @id @default(uuid())
  incident_id     String
  incident        Incident     @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  member_id       String
  member          TeamMember   @relation(fields: [member_id], references: [id])
  
  @@unique([incident_id, member_id])
}

model IncidentHistory {
  id              String       @id @default(uuid())
  incident_id     String
  incident        Incident     @relation(fields: [incident_id], references: [id], onDelete: Cascade)
  action          String // EJ: Creada, Asignada, Resuelta, etc.
  description     String
  created_at      DateTime     @default(now())
}

model OperationalResource {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  name            String
  type            String       @default("GENERICO") // VEHICULO, EQUIPO_LOGISTICO, MATERIAL, PUNTO_APOYO, GENERICO
  quantity        Int          @default(1)
  status          String       @default("DISPONIBLE") // DISPONIBLE, ASIGNADO, FUERA_SERVICIO
  notes           String?
  
  // Assignments M:N
  assignments     ResourceAssignment[]
  
  // Territorial link
  municipality_id    String?
  municipality       Municipality?   @relation(fields: [municipality_id], references: [id])
  zone_id            String?
  zone               Zone?           @relation(fields: [zone_id], references: [id])
  polling_station_id String?
  polling_station    PollingStation? @relation(fields: [polling_station_id], references: [id])
  polling_table_id   String?
  polling_table      PollingTable?   @relation(fields: [polling_table_id], references: [id])
}

model ResourceAssignment {
  id              String              @id @default(uuid())
  resource_id     String
  resource        OperationalResource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  member_id       String
  member          TeamMember          @relation(fields: [member_id], references: [id])
  quantity        Int                 @default(1)
  assigned_at     DateTime            @default(now())
  
  @@unique([resource_id, member_id])
}

// ==========================================
// 8. DATOS ELECTORALES Y DIVIPOLE (NUEVO)
// ==========================================

model ElectoralImport {
  id                     String                    @id @default(uuid())
  nombre_archivo         String
  hash_archivo           String
  fuente                 String
  eleccion               String
  fecha_fuente           String
  fecha_importacion      DateTime                  @default(now())
  usuario                String
  registros_procesados   Int                       @default(0)
  registros_creados      Int                       @default(0)
  registros_actualizados Int                       @default(0)
  registros_error        Int                       @default(0)
  estado                 String                    // PROCESANDO, COMPLETADO, COMPLETADO_CON_ADVERTENCIAS, ERROR
  activa                 Boolean                   @default(false)
  departments            ElectoralDepartment[]
  municipalities         ElectoralMunicipality[]
  stations               ElectoralPollingStation[]
  tables                 ElectoralPollingTable[]
}

model ElectoralDepartment {
  id                   String                   @id @default(uuid())
  codigo               String                   @unique // e.g. "05" (Antioquia)
  nombre               String
  votantes_habilitados Int                      @default(0)
  total_municipios     Int                      @default(0)
  total_puestos        Int                      @default(0)
  total_mesas          Int                      @default(0)
  fuente               String
  fecha_fuente         String
  fecha_actualizacion  DateTime                 @default(now())
  import_id            String
  import               ElectoralImport          @relation(fields: [import_id], references: [id])
  municipalities       ElectoralMunicipality[]
  stations             ElectoralPollingStation[]
  tables               ElectoralPollingTable[]
}

model ElectoralMunicipality {
  id                   String                   @id @default(uuid())
  codigo               String                   // e.g. "001" (Medellín)
  codigo_divipole      String                   @unique // e.g. "05001"
  departamento_id      String
  departamento         ElectoralDepartment      @relation(fields: [departamento_id], references: [id])
  nombre               String
  votantes_habilitados Int                      @default(0)
  total_puestos        Int                      @default(0)
  total_mesas          Int                      @default(0)
  fuente               String
  fecha_fuente         String
  fecha_actualizacion  DateTime                 @default(now())
  import_id            String
  import               ElectoralImport          @relation(fields: [import_id], references: [id])
  ubicaciones          ElectoralUbicacionTerritorial[]
  stations             ElectoralPollingStation[]
  tables               ElectoralPollingTable[]
}

model ElectoralUbicacionTerritorial {
  id                       String                   @id @default(uuid())
  municipality_id          String
  municipality             ElectoralMunicipality    @relation(fields: [municipality_id], references: [id])
  tipo                     String                   // CABECERA, CORREGIMIENTO, VEREDA, OTRO
  nombre                   String                   // e.g. "Cabecera Municipal", "Yarima"
  codigo                   String
  fuente                   String
  clasificacion_confirmada Boolean                  @default(false)
  fecha_actualizacion      DateTime                 @default(now())
  stations                 ElectoralPollingStation[]
  tables                   ElectoralPollingTable[]

  @@unique([municipality_id, tipo, nombre])
}

model ElectoralPollingStation {
  id                       String                   @id @default(uuid())
  codigo_divipole          String                   @unique // e.g. "050010101"
  departamento_id          String
  departamento             ElectoralDepartment      @relation(fields: [departamento_id], references: [id])
  municipio_id             String
  municipio                ElectoralMunicipality    @relation(fields: [municipio_id], references: [id])
  ubicacion_territorial_id String?
  ubicacion_territorial    ElectoralUbicacionTerritorial? @relation(fields: [ubicacion_territorial_id], references: [id])
  codigo_zona              String
  codigo_puesto            String
  nombre                   String
  direccion                String?
  comuna_localidad         String?
  mujeres                  Int?
  hombres                  Int?
  votantes_habilitados     Int                      @default(0)
  total_mesas              Int                      @default(0)
  latitud                  Float?
  longitud                 Float?
  fuente                   String
  fecha_fuente             String
  fecha_actualizacion      DateTime                 @default(now())
  import_id                String
  import                   ElectoralImport          @relation(fields: [import_id], references: [id])
  tables                   ElectoralPollingTable[]
}

model ElectoralPollingTable {
  id                       String                   @id @default(uuid())
  numero                   String
  puesto_votacion_id       String
  puesto_votacion          ElectoralPollingStation  @relation(fields: [puesto_votacion_id], references: [id])
  municipio_id             String
  municipio                ElectoralMunicipality    @relation(fields: [municipio_id], references: [id])
  departamento_id          String
  departamento             ElectoralDepartment      @relation(fields: [departamento_id], references: [id])
  ubicacion_territorial_id String?
  ubicacion_territorial    ElectoralUbicacionTerritorial? @relation(fields: [ubicacion_territorial_id], references: [id])
  votantes_habilitados     Int?                     // null if not provided per table
  fuente                   String
  fecha_fuente             String
  import_id                String
  import                   ElectoralImport          @relation(fields: [import_id], references: [id])

  @@unique([puesto_votacion_id, numero])
}

model ElectoralCampaign {
  id              String      @id @default(uuid())
  nombre          String
  corporacion     String      // Gobernación, Asamblea, Alcaldía, Concejo, JAL
  municipio       String
  departamento    String
  circunscripcion String
  created_at      DateTime    @default(now())
}

model ElectoralQueryLog {
  id                  String   @id @default(uuid())
  usuario             String
  fecha               DateTime @default(now())
  eleccion            String
  resultado           String   // ENCONTRADO, NO_ENCONTRADO, ERROR
  fuente              String
  documento_hash      String
  tiempo_respuesta_ms Int
}

model Encuesta {
  id                    String       @id @default(uuid())
  organization_id       String
  organization          Organization @relation(fields: [organization_id], references: [id])
  nombre                String
  comuna                String
  intencionVoto         String       // Nuestro Candidato, Opositor A, Opositor B, Indeciso, Blanco
  preocupacion          String       // Seguridad, Economía, Movilidad, Salud, Educación, Medio Ambiente, etc.
  calificacionGobierno  String       // Excelente, Aceptable, Mala
  dispuestoAVotar       String       // Completamente Seguro, Probable que cambie, Muy Indeciso, No asistiré a votar
  edad                  String
  sexo                  String       // Masculino, Femenino, Otro
  participacionJornada  String       // Sí participará, No participará, Indeciso
  fecha                 DateTime     @default(now())
}

model TransaccionFinanciera {
  id              String       @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id])
  descripcion     String
  categoria       String       // Publicidad, Personal, Eventos, Logística, Ingresos, etc.
  tipo            String       // INGRESO, EGRESO
  monto           Float
  fecha           String
  estado          String       @default("Completado") // Completado, Pendiente
  created_at      DateTime     @default(now())
}

